<Window x:Class="TechKingPOS.App.QuantityInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Quantity"
        WindowStartupLocation="Manual"
        Height ="150"
        Width="400">

     <Grid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Text="Enter Quantity:"/>
        <TextBox x:Name="QuantityTextBox" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="35" Margin="10"/>
        <Button Content="OK" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="75" Margin="10" Click="OkButton_Click"/>
    </Grid>
</Window>
