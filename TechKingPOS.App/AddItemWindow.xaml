<Window x:Class="TechKingPOS.App.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Item"
        Height="450"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6FB">

    <Grid Margin="10">

        <Border Background="White"
                CornerRadius="18"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                

                

                <!-- BODY -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="14,6,14,4">

                        <!-- BARCODE -->
                        <TextBlock Text="Scan Barcode"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,4"/>

                        <Grid Margin="0,0,0,6">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Height="40"
                                    CornerRadius="8"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Background="White">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#F9FAFB"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            CornerRadius="10,0,0,10">

                                        <TextBlock Text="║║║"
                                                   FontSize="20"
                                                   Foreground="#4B5563"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <TextBox x:Name="BarcodeInput"
                                             Grid.Column="1"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             Padding="8,0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="BarcodeInput_TextChanged"
                                             KeyDown="BarcodeInput_KeyDown"/>

                                    <Button Grid.Column="2"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Cursor="Hand">

                                        <TextBlock Text="⌖"
                                                   FontSize="20"
                                                   Foreground="#4B5563"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- SUGGESTIONS -->
                            <Border Grid.Row="1"
                                    Margin="0,4,0,0"
                                    CornerRadius="8"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Background="White">

                                <ListBox x:Name="BarcodeSuggestions"
                                         Visibility="Collapsed"
                                         BorderThickness="0"
                                         MaxHeight="140"
                                         SelectionChanged="BarcodeSuggestions_SelectionChanged"/>
                            </Border>
                        </Grid>

                        <!-- NAME -->
                        <TextBlock Text="Item Name"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,4"/>

                        <Grid Margin="0,0,0,6">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- INPUT -->
                            <Border Height="40"
                                    CornerRadius="8"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Background="White">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#F9FAFB"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,1,0"
                                            CornerRadius="10,0,0,10">

                                        <TextBlock Text="🏷"
                                                   FontSize="18"
                                                   Foreground="#4B5563"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Grid Grid.Column="1">

                                        <TextBox x:Name="NameBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 Padding="8,0"
                                                 VerticalContentAlignment="Center"/>

                                        <TextBlock Text="Enter item name"
                                                   Margin="12,0,0,0"
                                                   Foreground="#9CA3AF"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NameBox}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- SHARED SUGGESTIONS -->
                            <Border Grid.Row="1"
                                    Margin="0,4,0,0"
                                    CornerRadius="8"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Background="White">

                                <ListBox x:Name="ItemSuggestions"
                                         Visibility="Collapsed"
                                         BorderThickness="0"
                                         MaxHeight="140"
                                         DisplayMemberPath="Name"
                                         SelectionChanged="ItemSuggestions_SelectionChanged"/>
                            </Border>
                        </Grid>

                        <!-- ALIAS -->
                        <TextBlock Text="Alias"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,4"/>

                        <Border Height="40"
                                CornerRadius="8"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Background="White"
                                Margin="0,0,0,6">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,1,0"
                                        CornerRadius="10,0,0,10">

                                    <TextBlock Text="✎"
                                               FontSize="18"
                                               Foreground="#4B5563"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <Grid Grid.Column="1">

                                    <TextBox x:Name="AliasBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="12"
                                             Padding="8,0"
                                             VerticalContentAlignment="Center"/>

                                    <TextBlock Text="Enter alias (optional)"
                                               Margin="12,0,0,0"
                                               Foreground="#9CA3AF"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=AliasBox}"
                                                                 Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- PRODUCTION INFO -->
                        <Border x:Name="ProductionInfoPanel"
                                Visibility="Collapsed"
                                Background="#ECFDF3"
                                BorderBrush="#86EFAC"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6"
                                Margin="0,0,0,4">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="ℹ"
                                           FontSize="16"
                                           Foreground="#16A34A"
                                           Margin="0,0,12,0"/>

                                <StackPanel>

                                    <TextBlock Text="Production Mode"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#166534"/>

                                    <TextBlock Text="Prices are simplified in production mode. Unit price is mainly used for costing."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="#166534"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PRICES -->
                        <Grid x:Name="ProductionPricesGrid"
                                Margin="0,0,0,6"
                                Visibility="Collapsed">

                                <!-- ONLY ONE COLUMN -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- UNIT PRICE -->
                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="Unit Price"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#111827"
                                            Margin="0,0,0,4"/>

                                    <Border Height="40"
                                            CornerRadius="8"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            Background="White">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Background="#F9FAFB"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="0,0,1,0"
                                                    CornerRadius="8,0,0,8">

                                                <TextBlock Text="KSh"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#374151"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBox x:Name="UnitPriceBox"
                                                    Grid.Column="1"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Padding="8,0"
                                                    FontSize="12"
                                                    VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                            </Grid>
                            <Grid x:Name="VendorPricesGrid"
                              Margin="0,0,0,6"
                              >

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- UNIT -->
                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Unit Price"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Margin="0,0,0,4"/>

                                <Border Height="40"
                                        CornerRadius="8"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        Background="White">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#F9FAFB"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                CornerRadius="10,0,0,10">

                                            <TextBlock Text="KSh"
                                                       FontSize="12"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBox x:Name="MarkedPriceBox"
                                                 Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="8,0"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- RETAIL -->
                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Retail Price"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Margin="0,0,0,4"/>

                                <Border Height="40"
                                        CornerRadius="8"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        Background="White">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#F9FAFB"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                CornerRadius="10,0,0,10">

                                            <TextBlock Text="KSh"
                                                       FontSize="12"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBox x:Name="SellingPriceBox"
                                                 Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="12,0"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- WHOLESALE -->
                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Wholesale Price"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Margin="0,0,0,4"/>

                                <Border Height="40"
                                        CornerRadius="8"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        Background="White">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#F9FAFB"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                CornerRadius="10,0,0,10">

                                            <TextBlock Text="KSh"
                                                       FontSize="12"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBox x:Name="WholesalePriceBox"
                                                 Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="8,0"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>


                        <!-- QUANTITY + UNIT -->
                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- QUANTITY -->
                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Quantity"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Margin="0,0,0,4"/>

                                <Border Height="40"
                                        CornerRadius="8"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        Background="White">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#F9FAFB"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                CornerRadius="10,0,0,10">

                                            <TextBlock Text="⌗"
                                                       FontSize="18"
                                                       Foreground="#4B5563"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBox x:Name="QuantityBox"
                                                 Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontSize="12"
                                                 Padding="12,0"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- UNIT -->
                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Unit Type"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           Margin="0,0,0,4"/>

                                <Border Height="40"
                                        CornerRadius="8"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        Background="White">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#F9FAFB"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,1,0"
                                                CornerRadius="10,0,0,10">

                                            <TextBlock Text="◫"
                                                       FontSize="18"
                                                       Foreground="#4B5563"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <ComboBox x:Name="UnitTypeBox"
                                                  Grid.Column="1"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  FontSize="12"
                                                  Padding="8,0"
                                                  SelectionChanged="UnitType_Changed">

                                            <ComboBoxItem Content="pieces"/>
                                            <ComboBoxItem Content="kg"/>
                                            <ComboBoxItem Content="grams"/>
                                            <ComboBoxItem Content="mg"/>
                                            <ComboBoxItem Content="litres"/>
                                            <ComboBoxItem Content="meters"/>
                                            <ComboBoxItem Content="inches"/>
                                            <ComboBoxItem Content="feets"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- UNIT VALUE -->
                        <StackPanel x:Name="UnitValuePanel"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,6">

                            <TextBlock Text="Unit Value (per item)"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="0,0,0,4"/>

                            <Border Height="40"
                                    CornerRadius="8"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Background="White">

                                <TextBox x:Name="UnitValueBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="8,0"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- SUPPLIER -->
                        <TextBlock Text="Supplier"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0,0,0,4"/>

                        <Border Height="40"
                                CornerRadius="8"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Background="White"
                                Margin="0,0,0,6">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#F9FAFB"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="0,0,1,0"
                                        CornerRadius="10,0,0,10">

                                    <TextBlock Text="👥"
                                               FontSize="18"
                                               Foreground="#4B5563"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <TextBox x:Name="SupplierBox"
                                         Grid.Column="1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1,0,0,0"
                        Padding="6">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT -->
                        <StackPanel Orientation="Horizontal">

                            <Button Content="⬆ Upload File"
                                    Width="150"
                                    Height="28"
                                    Margin="0,0,12,0"
                                    Background="White"
                                    BorderBrush="#8B5CF6"
                                    BorderThickness="1.5"
                                    Foreground="#7C3AED"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="Upload_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="🖼 Import from Image"
                                    Width="190"
                                    Height="28"
                                    Background="White"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1.5"
                                    Foreground="#2563EB"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="ImportImage_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- RIGHT -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">

                            <Button Content="🧹 Clear"
                                    Width="120"
                                    Height="28"
                                    Margin="0,0,12,0"
                                    Background="White"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1.5"
                                    Foreground="#D97706"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="Clear_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="💾 Save Item"
                                    Width="150"
                                    Height="28"
                                    Background="#16A34A"
                                    BorderBrush="#16A34A"
                                    BorderThickness="1.5"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="Save_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>