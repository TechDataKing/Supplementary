<Window x:Class="TechKingPOS.App.MoveToRepackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move To Repack"
        Height="500" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <StackPanel Grid.Column="0">
            <TextBox x:Name="SearchBox"
         Height="30"
         Margin="0,0,0,10"
         Text="Search item..."
         Foreground="Gray"
         GotFocus="SearchBox_GotFocus"
         LostFocus="SearchBox_LostFocus"
         TextChanged="SearchBox_TextChanged"/>

            <ListBox x:Name="ItemsList"
                     DisplayMemberPath="Name"
                     SelectionChanged="ItemsList_SelectionChanged"/>
        </StackPanel>

        <!-- MIDDLE -->
        <StackPanel Grid.Column="1" Margin="10,0">

            <TextBlock Text="Selected Item:" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedItemText" Margin="0,0,0,10"/>

            <TextBlock Text="Available:" FontWeight="Bold"/>
            <TextBlock x:Name="AvailableText" Margin="0,0,0,10"/>

            <TextBlock Text="Move Quantity:"/>
            <TextBox x:Name="MoveQtyBox" Height="30" Margin="0,5,0,10"/>

           

            <TextBlock Text="DEFINE CONVERSION"
           FontWeight="Bold"
           Margin="0,5"/>

<StackPanel Orientation="Horizontal" Margin="0,10,0,10">

    <TextBlock Text="1"
               VerticalAlignment="Center"
               Margin="0,0,5,0"/>

    <!-- 🔥 THIS IS DYNAMIC -->
    <TextBlock x:Name="SourceUnitText"
               Text="-"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

    <TextBlock Text="="
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

    <TextBox x:Name="ConversionQtyBox"
             Width="80"
             Height="30"
             Margin="0,0,10,0"
             TextChanged="Recalculate"/>

    <ComboBox x:Name="UnitCombo"
              Width="100"
              Height="30"
              SelectionChanged="Recalculate">
        <ComboBoxItem Content="KG"/>
        <ComboBoxItem Content="Litre"/>
        <ComboBoxItem Content="PCS"/>
        <ComboBoxItem Content="FT"/>
    </ComboBox>

</StackPanel>

<Separator Margin="0,10"/>

<TextBlock Text="AUTO RESULT"
           FontWeight="Bold"
           Margin="0,5"/>

<TextBlock x:Name="TotalQtyText"
           Margin="0,5"
           Text="Total Quantity: -"/>

<TextBlock x:Name="CostText"
           Foreground="Gray"
           Margin="0,5"
           Text="Cost per unit: -"/>
            <Button Content="➡ MOVE TO REPACK"
                    Height="35"
                    Click="MoveToRepack_Click"/>
        </StackPanel>

        <!-- RIGHT -->
        <StackPanel Grid.Column="2">
            <TextBox x:Name="RepackSearchBox"
         Height="30"
         Margin="0,0,0,10"
         Text="Search repack..."
         Foreground="Gray"
         GotFocus="RepackSearchBox_GotFocus"
         LostFocus="RepackSearchBox_LostFocus"
         TextChanged="RepackSearchBox_TextChanged"/>

            <ListBox x:Name="RepackList"
                     DisplayMemberPath="Display"
                     Height="350"/>

            <Button Content="❌ REMOVE"
                    Height="35"
                    Margin="0,10,0,0"
                    Click="RemoveRepack_Click"/>
        </StackPanel>
    </Grid>
</Window>