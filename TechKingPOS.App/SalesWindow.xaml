<local:RefreshOnFocusWindow x:Class="TechKingPOS.App.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TechKingPOS.App.Services"
        Title="Sales"
        Height="700"
        Width="Auto"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        
        Focusable="True">


<Grid>
<Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="270"/>
</Grid.ColumnDefinitions>         

<Grid Grid.Column="0">
<Grid.RowDefinitions>

    <RowDefinition Height="*"/>

    <RowDefinition Height="60"/>

</Grid.RowDefinitions>

<Grid Grid.Row="0" Grid.Column="0">
<Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="LeftColumn" Width="0"/>
    <ColumnDefinition  Width="210"/>
    <ColumnDefinition Width="10"/>
    <ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>


<!-- ================= LEFT PANEL ================= -->

        <!-- ===================================== -->
        <!-- CATEGORIES -->
        <!-- ===================================== -->
<Border Grid.Column="0"
        Grid.Row="0"
        Background="White"
        BorderBrush="#E8E8E8"
        BorderThickness="1"
        CornerRadius="8">


            <Grid Margin="6">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <TextBlock Text="Departments"
                           FontWeight="Bold"
                           FontSize="12"
                           Margin="2,2,2,8"/>

                <!-- LOAD FROM DATABASE -->

                <ListBox x:Name="DepartmentList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="12"/>

            </Grid>
</Border>
<Border Grid.Column="1"
        Grid.Row="0"
        Background="White"
        BorderBrush="#E8E8E8"
        BorderThickness="1"
        CornerRadius="8">

    <Grid>

<Grid.RowDefinitions>

    <!-- Header -->
    <RowDefinition Height="42"/>

    <!-- Search -->
    <RowDefinition Height="42"/>

    <!-- Filters -->
    <RowDefinition Height="40"/>

 

    <!-- Quick Items -->
    <RowDefinition Height="*"/>

 

</Grid.RowDefinitions>

        <!-- ===================================== -->
        <!-- HEADER -->
        <!-- ===================================== -->

        <Grid Grid.Row="0" Margin="8,5">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="30"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="24"
                    Height="24"
                    Content="☰"
                    FontSize="13"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ItemLookup_Click"/>

            <TextBlock Grid.Column="1"
                       Text="Item Lookup"
                       FontWeight="SemiBold"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>

        </Grid>

        <!-- ===================================== -->
        <!-- SEARCH -->
        <!-- ===================================== -->

        <Border Grid.Row="1"
                Margin="8,0"
                BorderBrush="#D9DDE4"
                BorderThickness="1"
                CornerRadius="6"
                Background="White">

            <Grid>

                <TextBox x:Name="SearchBox"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="10,6,35,6"/>

                <TextBlock Text="Scan barcode or search item..."
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="#9A9A9A"
                           IsHitTestVisible="False">

                    <TextBlock.Style>

                        <Style TargetType="TextBlock">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}"
                                             Value="0">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>

                <TextBlock HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#777"
                           FontSize="13"
                           Text="🔍"/>

            </Grid>

        </Border>

        <!-- ===================================== -->
        <!-- FILTERS -->
        <!-- ===================================== -->

        <Grid Grid.Row="2"
              Margin="8,6,8,6">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="6"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <ComboBox x:Name="CategoryCombo"
                      Height="28"
                      BorderBrush="#D9DDE4"
                      BorderThickness="1">


            </ComboBox>

            <ComboBox x:Name="BrandCombo"
                      Grid.Column="2"
                      Height="28"
                      BorderBrush="#D9DDE4"
                      BorderThickness="1">


            </ComboBox>

        </Grid>


     
        <!-- ===================================== -->
<!-- QUICK ITEMS -->
<!-- ===================================== -->

<Grid Grid.Row="3" Margin="8">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Quick Items"
               FontWeight="Bold"
               FontSize="12"
               Margin="0,0,0,8"/>

    <!-- KEEP EXISTING NAME -->
    <ListBox x:Name="ItemsList"
             Grid.Row="1"
             DisplayMemberPath="Item2"
             MouseDoubleClick="ItemsList_DoubleClick"
             Background="Transparent"
             BorderThickness="0"
             FontSize="12"
             ScrollViewer.VerticalScrollBarVisibility="Auto">

        <ListBox.ItemContainerStyle>

            <Style TargetType="ListBoxItem">

                <Setter Property="Padding" Value="6"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            </Style>

        </ListBox.ItemContainerStyle>

    </ListBox>

</Grid>



    </Grid>

</Border>
        <!-- ================= RIGHT PANEL ================= -->

 <Border Grid.Column="3"
        Grid.Row="0"
        Background="White"
        BorderBrush="#E6E6E6"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10">

        <Grid>



    <Grid.RowDefinitions>

        <RowDefinition Height="40"/>      <!-- header -->


        <RowDefinition Height="*"/>       <!-- datagrid -->

        <RowDefinition Height="40"/>      <!-- hold/retrieve -->

    </Grid.RowDefinitions>

            <!-- TOP -->
<Border
        Background="White"
        BorderBrush="#E6E6E6"
        BorderThickness="1"
        CornerRadius="8"
        Padding="4">

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="220"/>

            <ColumnDefinition Width="35"/>

            <ColumnDefinition Width="35"/>

        </Grid.ColumnDefinitions>

        <!-- Cart Title -->

        <TextBlock  Text="Cart Items"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   
                   FontSize="12"/>
        <TextBlock x:Name="TotalItemsText"
                    Grid.Column="1"
                    Text ="0"
                    Foreground="#164355"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0"
                    FontWeight="Bold"
                   FontSize="12"/>

        <!-- Barcode Search -->
        
        <Border Grid.Column="3"
                BorderBrush="#D9DDE4"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>

            <TextBox x:Name="ScannerBox"
                    BorderThickness="0"
                    Padding="4"
                    Height="24"
                    Background="Transparent"
                    KeyDown="ScannerBox_KeyDown"
                    TextChanged="ScannerBox_TextChanged"/>

            <TextBlock Text="Scan barcode"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="#9A9A9A"
                           IsHitTestVisible="False">
                <TextBlock.Style>

                        <Style TargetType="TextBlock">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Text.Length, ElementName=ScannernBox}"
                                             Value="0">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>
                <TextBlock HorizontalAlignment="Right"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#777"
                           FontSize="13"
                           Text="🔍"/>
            </Grid>

        </Border>

        <!-- Barcode -->

        <Button Grid.Column="4"
                Margin="1,0,0,0"
                Height="26"
                Background="Transparent"
                Content="▥">
            <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#D9DDE4"
                                BorderThickness="1"
                                
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        <!-- Receipt -->

        <Button Grid.Column="5"
                Margin="3,0,0,0"
                Height="26"
                Background="Transparent"
                Content="🧾">
        <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#D9DDE4"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

    </Grid>
</Border>


            <!-- CART -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E6E6E6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,6">
            <DataGrid
                    
                    x:Name="CartGrid"
                    Margin="0,10,0,10"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    
                    GridLinesVisibility="None"
                    BorderThickness="0"
                    HeadersVisibility="Column"
                    RowBackground="Transparent"
                    AlternatingRowBackground="Transparent"
                    >

                    <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0,4"/> <!-- spacing -->
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>

                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EAF3FF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Trigger>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F8FC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>


                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="120"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitType}" Width="150"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="150"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            </Border>

                <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,6">

            <Button Content="🗑 Remove (Del)"
                    Background="#FFF4F4"
                    Foreground="#E53935"
                    BorderBrush="#FFD6D6"
                    BorderThickness="2"
                    Cursor="Hand"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="DeleteItem_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>    

            <Button Content="🗑 Clear Cart"
                    Background="#FFF4F4"
                    Foreground="#E53935"
                    BorderBrush="#D9DDE4"
                    BorderThickness="2"
                    Cursor="Hand"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0"
                    Click="DeleteAll_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Change Price"
                    Background="White"
                    Foreground="White"
                    BorderBrush="#D4567A"
                    BorderThickness="2"
                    Cursor="Hand"
                    Margin="0,0,8,0"
                    Height="30"
                    Width="120"
                    Click="ChangePrice_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Margin="0,0,8,0"
                    Background="White"
                    Foreground="White"
                    BorderBrush="#5678A3"
                    BorderThickness="2"
                    Height="30"
                    Width="120"
                    Cursor="Hand"
                    Content="Change Quantity"
                    Click="ChangeQty_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button 
                    Content="Discount "
                    Background="White"
                    Foreground="White"
                    BorderBrush="#DC5678"
                    BorderThickness="2"
                    Height="30"
                    Width="120"
                    Cursor="Hand"
                    Click="Discount_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

      

 
</Grid>
</Border>

</Grid>
<Border Grid.Row="1"
        Grid.RowSpan="4"
        Margin="3,0,0,0"
        Background="White"
        BorderBrush="#E6E6E6"
        BorderThickness="1"
        CornerRadius="8"
        Padding="8">

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            
            <Button Content="Calculator"
                    Margin="0,0,10,0"
                    Width="120"
                    Height="24"
                    Background="White"
                    BorderBrush="#17CB23"
                    Foreground="White"
                    BorderThickness="2"
                    Cursor="Hand"
                    Click="Calculator_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Drawer" 
                    Margin="0,0,10,0"
                    Width="120"
                    Height="24"
                    Background="White"
                    BorderBrush="#173568"
                    Foreground="White"
                    Cursor="Hand"
                    BorderThickness="2"
                    >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Secure" 
                    Margin="0,0,10,0"
                    Width="120"
                    Height="24"
                    Background="#16A34A"
                    Foreground="White"
                    Cursor="Hand"
                    BorderThickness="2"
                    BorderBrush="#164355">
            <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
             
                
</Border> 
<!-- ===================================== -->
<!-- PAYMENT PANEL -->
<!-- ===================================== -->

</Grid>

<Border Grid.Column="1"
        
        Grid.RowSpan="4"
        Margin="10,0,0,0"
        Background="White"
        BorderBrush="#E6E6E6"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12">

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>   <!-- btn -->
            <RowDefinition Height="Auto"/>   <!-- title -->

            <RowDefinition MaxHeight="120"/>   <!-- customer -->

            <RowDefinition Height="Auto"/>   <!-- payment -->

            <RowDefinition Height="Auto"/>   <!-- buttons -->


            <RowDefinition Height="Auto"/>   <!-- textbox -->


            <RowDefinition Height="*"/>      <!-- totals -->

            <RowDefinition Height="Auto"/>   <!-- print -->

            <RowDefinition Height="Auto"/>   <!-- finish -->

        </Grid.RowDefinitions>

        <!-- TITLE -->

        <TextBlock Grid.Row="1"
            Text="Current Sale (Customer)"
            FontWeight="Bold"
            FontSize="12"/>
<Border Grid.Row="0"
        Background="White"
        CornerRadius="8"
        Padding="6">
    <StackPanel Orientation= "Horizontal">
        <ToggleButton x:Name="SaleTypeToggle"
              Width="90"
              Height="34"
              Margin="0,6,0,0"
              FontWeight="SemiBold"
              FontSize="14"
              Foreground="White"
              Cursor="Hand"
              Content="Retail"
              Checked="SaleTypeToggle_Checked"
              Unchecked="SaleTypeToggle_Unchecked">

    <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">

            <Border x:Name="Bd"
                    CornerRadius="6"
                    Background="#2E7D32"
                    BorderBrush="#1B5E20"
                    BorderThickness="1">

                <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

            <ControlTemplate.Triggers>

                <!-- Wholesale -->
                <Trigger Property="IsChecked"
                         Value="True">

                    <Setter TargetName="Bd"
                            Property="Background"
                            Value="#1565C0"/>

                    <Setter TargetName="Bd"
                            Property="BorderBrush"
                            Value="#0D47A1"/>

                </Trigger>

                <!-- Hover -->
                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="Bd"
                            Property="Opacity"
                            Value="0.9"/>

                </Trigger>

                <!-- Pressed -->
                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="Bd"
                            Property="Opacity"
                            Value="0.75"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>
    </ToggleButton.Template>

</ToggleButton>

<Button 
                Margin="8,0,6,0"
                Height="34"
                Width="90"
                Content="New Sale "
                Click="AddCustomer_Click"
                Background="#2F6FED"
                BorderBrush="#2F6FED"
                BorderThickness="1"
                Cursor="Hand"
                Foreground="White"
                FontWeight="SemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding BorderBrush}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

</StackPanel>
</Border>

        <!-- CUSTOMER -->
<Border Grid.Row="2"
        Background="White"
        CornerRadius="8"
        Padding="10">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Customers -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== ACTIVE CUSTOMERS (2 x 3) ========== -->
        <UniformGrid Grid.Row="0"
                     Columns="1"
                     Rows="2"
                     Margin="0,3,0,0"
                     VerticalAlignment="Top">

            <!-- Customer Slots (placeholders) -->
            <Button x:Name="Customer1Btn" Cursor="Hand" Content="Customer 1" Height="25" Click="Customer_Click"/>
            <Button x:Name="Customer2Btn" Cursor="Hand" Content="Customer 2" Height="25" Visibility="Collapsed" Margin="0,3,0,0" Click="Customer_Click"/>
            <Button x:Name="Customer3Btn"  Cursor="Hand" Content="Customer 3" Height="25" Visibility="Collapsed" Click="Customer_Click"/>
            <Button x:Name="Customer4Btn" Cursor="Hand" Content="Customer 4" Height="25" Visibility="Collapsed" Click="Customer_Click"/>
            <!-- <Button x:Name="Customer5Btn" Content="Customer 5" Height="25" Visibility="Collapsed" Click="Customer_Click"/>
            <Button x:Name="Customer6Btn" Content="Customer 6" Height="25" Visibility="Collapsed" Click="Customer_Click"/> -->
            

        </UniformGrid>
    </Grid>
    </Border>
        <!-- PAYMENT -->
      

        <TextBlock Grid.Row="3"
                   Text="Payment Method"
                   FontWeight="SemiBold"
                   FontSize="12"/>

        <Grid Grid.Row="4"
              Margin="0,8,0,12">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="10"/>

                <ColumnDefinition/>

            </Grid.ColumnDefinitions>

            <Button
                x:Name="MpesaQuickBtn"
                Grid.Column="0"
                Height="34"
                Background="#16A34A"
                Foreground="White"
                Content="M-PESA"
                Cursor="Hand"
                Click="QuickPayment_Click">
            <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E6E6E6"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button
                x:Name="CashQuickBtn"
                Grid.Column="2"
                Height="34"
                Background="White"
                BorderBrush="#D8D8D8"
                Content="Cash"
                Cursor="Hand"
                Click="QuickPayment_Click">
            <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="#E6E6E6"
                            BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>

        <!-- AMOUNT -->

        <!-- <TextBlock Grid.Row="4"
                   Text="Amount Transacted"
                   FontSize="11"/> -->

        <!-- <TextBox Grid.Row="4"
                 Height="32"
                 Margin="0,4,0,10"/> -->

        <!-- CASH -->
          <Grid x:Name="CashRow" Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
        <TextBlock Grid.Row="0"
                   Text="Cash Given"
                   FontSize="11"
                   VerticalAlignment="Top"/>
        <Border Grid.Row="1"
                CornerRadius="8"
                BorderBrush="#E6E6E6"
                BorderThickness="1">
        <TextBox 
            x:Name="CashGivenBox"
            Height="32"
            BorderThickness="0"
            VerticalAlignment="Top"
            TextChanged="CashGiven_TextChanged"/>
        </Border>

        <!-- CHANGE -->

        <StackPanel  x:Name="ChangeRow"
                    Grid.Row="2"
                    Margin="0,10,0,10">

            <TextBlock Text="Change"/>

            <TextBlock
                x:Name="ChangeText"
                FontSize="22"
                FontWeight="Bold"
                Foreground="#16A34A"
                Text="0.00"/>

        </StackPanel>
        </Grid>
    
        <StackPanel Grid.Row="6"
            Margin="0,6,0,0">

    <Grid Margin="0,5">

        <Grid.ColumnDefinitions>

            <ColumnDefinition/>

            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>

        <TextBlock Text="Subtotal"/>

        <TextBlock Grid.Column="1"
                   x:Name="SubtotalText"
                   Text="0.00"/>

    </Grid>

    <Grid Margin="0,5" x:Name="DiscountRow">

        <Grid.ColumnDefinitions >

            <ColumnDefinition/>

            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>

        <TextBlock Text="Discount"/>

        <TextBlock Grid.Column="1"
                   x:Name="DiscountText"
                   Text="0.00"/>

    </Grid>

    <Grid Margin="0,5">

        <Grid.ColumnDefinitions>

            <ColumnDefinition/>

            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>

        <TextBlock Text="Tax"/>

        <TextBlock Grid.Column="1"
                   Text="0.00"/>

    </Grid>

    <Separator Margin="0,8"/>

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition/>

            <ColumnDefinition Width="Auto"/>

        </Grid.ColumnDefinitions>

        <TextBlock Text="Total"
                   FontWeight="Bold"
                   FontSize="16"/>

        <TextBlock Grid.Column="1"
                   x:Name="TotalAmountText"
                   FontWeight="Bold"
                   FontSize="26"
                   Foreground="#222"
                   Text="0.00"/>

    </Grid>

</StackPanel>

        <!-- PRINT -->

        <StackPanel Orientation="Horizontal"
            Grid.Row="7"
            Margin="10">

    <RadioButton x:Name="PrintReceiptCheckBox"
                 Content="Print"
