<Window x:Class="TechKingPOS.App.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Width"
        MinWidth="400"
        Title="Print Preview"
        MaxWidth="1200"
        Height="800">

    <DockPanel>
        <Button DockPanel.Dock="Top"
                Content="🖨 Print"
                Height="40"
                Margin="10"
                Width="100"
                Background="#007ACC"
                Foreground="White"
                Click="Print_Click"/>

        <!-- ✅ THIS supports FlowDocument -->
        <FlowDocumentScrollViewer x:Name="PreviewViewer"/>
    </DockPanel>
</Window>
