<Window x:Class="TechKingPOS.App.PendingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment Window"
        Height="600"
        Width="900"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F8F5">

    <Grid Margin="15">

        <Grid.RowDefinitions>

            <!-- Payment Summary -->
            <RowDefinition Height="70"/>

            <!-- Payment Body -->
            <RowDefinition Height="*"/>

            <!-- Buttons -->
            <RowDefinition Height="54"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- PAYMENT SUMMARY -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                CornerRadius="10"
                BorderBrush="#28A745"
                BorderThickness="1.2"
                Background="White"
                Padding="6">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- ================= TOTAL ================= -->

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="💵 Total Amount"
                        FontWeight="Bold"
                        FontSize="15"
                        Foreground="#006B2E"/>

                    <TextBlock
                        x:Name="TotalText"
                        Margin="0,3,0,0"
                        Text="0.00"
                        FontWeight="Bold"
                        FontSize="26"
                        Foreground="#006B2E"/>

                </StackPanel>

                <!-- Divider -->

                <Border
                    Grid.Column="1"
                    Width="1"
                    Background="#DDDDDD"
                    Margin="8"/>

                <!-- ================= PAID ================= -->

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="💰 Amount Paid"
                        FontWeight="Bold"
                        FontSize="15"
                        Foreground="#006B2E"/>

                    <TextBlock
                        x:Name="PaidText"
                        Margin="0,3,0,0"
                        Text="0.00"
                        FontWeight="Bold"
                        FontSize="26"
                        Foreground="#222"/>

                </StackPanel>

                <!-- Divider -->

                <Border
                    Grid.Column="3"
                    Width="1"
                    Background="#DDDDDD"
                    Margin="8"/>

                <!-- ================= CHANGE ================= -->

                <StackPanel
                    x:Name="ChangePanel"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="🪙 Change"
                        FontWeight="Bold"
                        FontSize="15"
                        Foreground="#F57C00"/>

                    <TextBlock
                        x:Name="ChangeText"
                        Margin="0,3,0,0"
                        Text="0.00"
                        FontWeight="Bold"
                        FontSize="26"
                        Foreground="#F57C00"/>

                </StackPanel>

                <!-- Divider -->

                <Border
                    Grid.Column="5"
                    Width="1"
                    Background="#DDDDDD"
                    Margin="8"/>

                <!-- ================= BALANCE ================= -->

                <StackPanel
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="⚖ Balance / Credit"
                        FontWeight="Bold"
                        FontSize="15"
                        Foreground="#D32F2F"/>

                    <TextBlock
                        x:Name="BalanceText"
                        Margin="0,3,0,0"
                        Text="0.00"
                        FontWeight="Bold"
                        FontSize="26"
                        Foreground="#D32F2F"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- BODY -->
        <!-- ================================================= -->

<Grid Grid.Row="1" Margin="0,6">

    <Grid.ColumnDefinitions>

        <!-- Left -->
        <ColumnDefinition Width="320"/>

        <!-- Space -->
        <ColumnDefinition Width="15"/>

        <!-- Right -->
        <ColumnDefinition Width="*"/>

    </Grid.ColumnDefinitions>

    <!-- ===================================================== -->
    <!-- LEFT PANEL -->
    <!-- ===================================================== -->

    <Border Grid.Column="0"
            Background="White"
            BorderBrush="#D6EFD9"
            BorderThickness="1.2"
            CornerRadius="12"
            Padding="7">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="15"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- TITLE -->
            <!-- ========================================== -->


                <TextBlock FontSize="22"
                           Text="💳 PAYMENT  METHOD"
                           Foreground="#138A36"
                           Padding="6"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>


    

            <!-- ========================================== -->
            <!-- CASH -->
            <!-- ========================================== -->

            <Border Grid.Row="1"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="6">

                <RadioButton x:Name="CashRadio"
                             GroupName="Payment"
                             FontSize="18"
                             Content="💵   Cash only"
                             Checked="CashRadio_Checked"/>

            </Border>

            <!-- ========================================== -->
            <!-- CASH + MPESA -->
            <!-- ========================================== -->

            <Border Grid.Row="3"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="6">

                <RadioButton x:Name="MixedRadio"
                             GroupName="Payment"
                             FontSize="18"
                             Content="💳   Cash + Mpesa"
                             Checked="MixedRadio_Checked"/>

            </Border>

            <!-- ========================================== -->
            <!-- MPESA -->
            <!-- ========================================== -->

            <Border Grid.Row="5"
                    Background="#F1FFF2"
                    CornerRadius="10"
                    BorderBrush="#2CBF4F"
                    BorderThickness="1.5"
                    Padding="6">

                <RadioButton x:Name="MpesaRadio"
                             GroupName="Payment"
                             FontSize="18"
                             Content="📱   Mpesa only"
                             Checked="MpesaRadio_Checked"/>

            </Border>

            <!-- ========================================== -->
            <!-- CREDIT -->
            <!-- ========================================== -->

            <Border Grid.Row="7"
                    CornerRadius="10"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1"
                    Padding="6">

                <RadioButton x:Name="CreditRadio"
                             GroupName="Payment"
                             FontSize="18"
                             Content="👥   Credit (Customer)"
                             Checked="PaymentMode_Checked"/>

            </Border>

            <!-- ========================================== -->
            <!-- NOTE -->
            <!-- ========================================== -->

            <Border Grid.Row="8"
                    Margin="0,6,0,0"
                    Padding="6"
                    CornerRadius="10"
                    BorderBrush="#FFC857"
                    BorderThickness="1"
                    Background="#FFFDF6"
                    VerticalAlignment="Top">

                <StackPanel>

                    <TextBlock Text="💡 Note"
                               FontWeight="Bold"
                               FontSize="18"
                               Foreground="#D48806"/>

                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="#555"
                               Text="Select Mpesa transactions from the list or enter the payment manually if it is not available."/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

<!-- ===================================================== -->
<!-- RIGHT PANEL -->
<!-- ===================================================== -->

<Border Grid.Column="2"
        Background="White"
        BorderBrush="#D6EFD9"
        BorderThickness="1.2"
        CornerRadius="12"
        Padding="7">

    <Grid>

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="15"/>

            <!-- Auto / Manual Buttons -->
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="20"/>

            <!-- Content -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- TITLE -->
        <!-- ===================================================== -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="10"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

                <TextBlock
                    Text="📱 Mpesa Payment"
                    FontWeight="Bold"
                    FontSize="16"
                    Foreground="#138A36"/>

            <Button Grid.Column="1"
                    x:Name="BtnAutoSelect"
                    Content="🤖 Auto "
                    Width="100"
                    Height="35"
                    FontSize="15"     
                    Background="#138A36"
                    Foreground="White"
                    BorderBrush="#138A36"
                    Cursor="Hand"
                    Click="Auto_Click">
                    
                <Button.Template>

            <ControlTemplate TargetType="Button">

                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

            </ControlTemplate>

        </Button.Template>

    </Button>

            <Button Grid.Column="3"
                    x:Name="BtnManualEntry"
                    Content="✏ Manual"
                    Width="100"
                    Height="35"
                    FontSize="15"                   
                    Background="White"
                    Foreground="#333"
                    BorderBrush="#CCCCCC"
                    Cursor="Hand"
                    Click="Manual_Click">
                <Button.Template>

            <ControlTemplate TargetType="Button">

                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

            </ControlTemplate>

        </Button.Template>
        </Button>
                

        </Grid>

        <!-- ===================================================== -->
        <!-- AUTO PANEL -->
        <!-- ===================================================== -->

        <Border Grid.Row="4"
                x:Name="AutoPanel"
                Background="#FCFFFC"
                BorderBrush="#CBEACF"
                BorderThickness="1.2"
                CornerRadius="10"
                Padding="6">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="12"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="💬 Pending Mpesa Transactions"
                        FontWeight="Bold"
                        FontSize="19"
                        Foreground="#138A36"/>

                    <TextBlock
                        Margin="0,4,0,0"
                        Text="Select the SMS that matches this payment."
                        FontSize="14"
                        Foreground="#666"/>

                </StackPanel>

                <!-- ==================== GRID ==================== -->

                <DataGrid Grid.Row="2"
                          x:Name="MessagesGrid"
                          Margin="0,5,0,0"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E5E5"
                          VerticalGridLinesBrush="#FFFFFF"
                          BorderBrush="#2CBF4F"
                          BorderThickness="1"
                          Background="White"
                          RowHeight="26"
                          FontSize="14"
                          PreviewMouseLeftButtonDown="MessagesGrid_PreviewMouseLeftButtonDown">

                    <DataGrid.ColumnHeaderStyle>

                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background" Value="#EAF8ED"/>

                            <Setter Property="Foreground" Value="#138A36"/>

                            <Setter Property="FontWeight" Value="Bold"/>

                            <Setter Property="FontSize" Value="15"/>

                            <Setter Property="Height" Value="40"/>

                            <Setter Property="BorderBrush" Value="#CBEACF"/>

                            <Setter Property="BorderThickness" Value="0,0,0,1"/>

                        </Style>

                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>

                        <!-- Select -->

                    <DataGridCheckBoxColumn
                        Header=""
                        Width="35"
                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- Sender -->

                        <DataGridTextColumn
                            Header="Sender"
                            Width="*"
                            Binding="{Binding Sender}"/>
                        <!-- Amount -->

                        <DataGridTextColumn
                            Header="Amount"
                            Width="80"
                            Binding="{Binding Amount,StringFormat={}{0:N2}}"/>
                        <!-- Code -->

                        <DataGridTextColumn
                            Header="Code"
                            Width="100"
                            Binding="{Binding Code}"/>
                        

                        

                        <!-- Time -->

                        <DataGridTextColumn
                            Header="Time"
                            Width="60"
                            Binding="{Binding Time,StringFormat={}{0:HH:mm:ss dd-MM-yyyy}}"/>

                        

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>
        <Border x:Name="ManualPanel"
                Grid.Row="4"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="#CBEACF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
        <StackPanel >
                    <TextBlock Text="Mpesa PaY:" FontSize="14" Margin="0,0,0,3"/>
                    <!-- Read-only Amount -->
                    <TextBlock x:Name="TxtMpesaAmount" Width="200" Height="25" 
                            Background="#FFF0FFF0" Padding="3"
                            Text="0.00"
                            />

                    <!-- Mpesa Code Input -->
                    <TextBlock Text="Mpesa Code:" FontSize="14" Margin="0,5,0,3"/>
                    <TextBox Name="TxtMpesaCode" Width="200" Height="25" BorderBrush="#FF28A745" BorderThickness="1"/>
                
        </StackPanel>
        </Border>
        <Border x:Name="CashPanel"
                Grid.Row="4"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="#CBEACF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <StackPanel>

                <TextBlock
                    Text="Cash Received"
                    FontWeight="Bold"
                    FontSize="18"/>

                <Border
                    Margin="0,10,0,0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="8">

                    <TextBox
                        x:Name="CashBox"
                        Height="38"
                        BorderThickness="0"
                        FontSize="20"
                        Padding="10,5"
                        TextChanged="CashBox_TextChanged"/>
                </Border>

            </StackPanel>

        </Border>

    </Grid>

</Border>

</Grid>

        <!-- ================================================= -->
        <!-- FOOTER BUTTONS -->
        <!-- ================================================= -->

<!-- ========================================================= -->
<!-- FOOTER -->
<!-- ========================================================= -->

<Grid Grid.Row="2" Margin="0,15,0,0">

    <Grid.ColumnDefinitions>

        <ColumnDefinition Width="*"/>

        <ColumnDefinition Width="210"/>

        <ColumnDefinition Width="15"/>

        <ColumnDefinition Width="180"/>

    </Grid.ColumnDefinitions>

    <!-- =================================================== -->
    <!-- CONFIRM -->
    <!-- =================================================== -->

    <Button Grid.Column="1"
            x:Name="BtnConfirm"
            Height="40"
            FontSize="18"
            FontWeight="Bold"
            Cursor="Hand"
            Click="Match_Click"
            Content="✔ Confirm Payment"
            Background="#168A3A"
            Foreground="White"
            BorderBrush="#168A3A"
            BorderThickness="1">

        <Button.Template>

            <ControlTemplate TargetType="Button">

                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

            </ControlTemplate>

        </Button.Template>

    </Button>

    <!-- =================================================== -->
    <!-- CANCEL -->
    <!-- =================================================== -->

    <Button Grid.Column="3"
            x:Name="BtnCancel"
            Height="40"
            FontSize="18"
            FontWeight="Bold"
            Cursor="Hand"
            Click="Cancel_Click"
            Content="❌ Cancel"
            Background="#F44336"
            Foreground="White"
            BorderBrush="#F44336"
            BorderThickness="1">

        <Button.Template>

            <ControlTemplate TargetType="Button">

                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">

                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>

            </ControlTemplate>

        </Button.Template>

    </Button>

</Grid>

    </Grid>

</Window>